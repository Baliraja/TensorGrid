	fall_transition(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("0.10845,0.14197,0.24301,0.42893,0.73470,1.18000,1.77100,2.51900,3.43100,4.52000");
