library (integration_final) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 3.00;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
  }

  cell ("integration_final") {
    area : 917928.312 
    is_macro_cell : true;
    pin("i_clk") {
      direction : input;
      clock : true;
      capacitance : 0.1539;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("4.10339");
	}
	cell_fall(scalar) {
          values("4.25890");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("5.29489");
	}
	cell_fall(scalar) {
          values("5.36211");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0101;
    }
    pin("i_uart_rx") {
      direction : input;
      capacitance : 0.0105;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-1.04364");
	}
	fall_constraint(scalar) {
          values("-0.65498");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.62068");
	}
	fall_constraint(scalar) {
          values("1.42310");
	}
      }
    }
    pin("o_uart_tx") {
      direction : output;
      capacitance : 0.0020;
      timing() {
        related_pin : "i_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("8.76523,8.83294,9.05175,9.45907,10.09107,10.97607,12.13876,13.60476,15.39138,17.52276");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("0.22564,0.32287,0.68032,1.39031,2.50300,4.06338,6.11700,8.70169,11.86000,15.62310");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("8.13529,8.19389,8.35425,8.59753,8.93853,9.40253,10.01053,10.77553,11.70953,12.82207");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("0.20859,0.26929,0.44855,0.77280,1.29953,2.07000,3.09900,4.40200,5.99347,7.89093");
	}
      }
    }
  }

}
