library (integration_final) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 3.30;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
  }

  cell ("integration_final") {
    area : 917928.312 
    is_macro_cell : true;
    pin("i_clk") {
      direction : input;
      clock : true;
      capacitance : 0.1412;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("2.09173");
	}
	cell_fall(scalar) {
          values("2.16714");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("2.64446");
	}
	cell_fall(scalar) {
          values("2.68664");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0096;
    }
    pin("i_uart_rx") {
      direction : input;
      capacitance : 0.0098;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.48283");
	}
	fall_constraint(scalar) {
          values("-0.29851");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.74896");
	}
	fall_constraint(scalar) {
          values("0.68133");
	}
      }
    }
    pin("o_uart_tx") {
      direction : output;
      capacitance : 0.0019;
      timing() {
        related_pin : "i_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("4.47025,4.50672,4.62619,4.85078,5.19971,5.68856,6.33056,7.13956,8.12599,9.30457");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("0.11587,0.16941,0.36773,0.76071,1.37457,2.23500,3.36700,4.79400,6.53700,8.61200");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("4.14713,4.17909,4.26754,4.40421,4.59955,4.86872,5.22172,5.66672,6.20972,6.85772");
