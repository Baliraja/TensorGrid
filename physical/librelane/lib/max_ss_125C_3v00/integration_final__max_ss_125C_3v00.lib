library (integration_final) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 3.00;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
  }

  cell ("integration_final") {
    area : 917921.750 
    is_macro_cell : true;
    pin("i_clk") {
      direction : input;
      clock : true;
      capacitance : 0.1687;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("4.16245");
	}
	cell_fall(scalar) {
          values("4.31292");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("5.07682");
	}
	cell_fall(scalar) {
          values("5.18474");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0102;
    }
    pin("i_uart_rx") {
      direction : input;
      capacitance : 0.0104;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.93125");
	}
	fall_constraint(scalar) {
          values("-0.55968");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.51095");
	}
	fall_constraint(scalar) {
          values("1.33003");
	}
      }
    }
    pin("o_uart_tx") {
      direction : output;
      capacitance : 0.0020;
      timing() {
        related_pin : "i_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("8.99322,9.06096,9.27980,9.68714,10.31914,11.20414,12.36680,13.83280,15.61948,17.75080");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("0.22559,0.32282,0.68034,1.39034,2.50300,4.06332,6.11700,8.70166,11.86000,15.62339");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("8.36609,8.42469,8.58506,8.82833,9.16933,9.63333,10.24133,11.00633,11.94033,13.05287");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("0.20859,0.26928,0.44855,0.77280,1.29955,2.07000,3.09900,4.40200,5.99345,7.89090");
	}
      }
    }
  }

}
