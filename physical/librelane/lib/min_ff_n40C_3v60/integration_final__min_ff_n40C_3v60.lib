library (integration_final) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 3.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00345,  0.01205,  0.02847,  0.05405,  0.08994,  0.13720,  0.19670,  0.26930,  0.35590");
  }

  cell ("integration_final") {
    area : 917921.750 
    is_macro_cell : true;
    pin("i_clk") {
      direction : input;
      clock : true;
      capacitance : 0.1422;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.23759");
	}
	cell_fall(scalar) {
          values("1.27218");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.46892");
	}
	cell_fall(scalar) {
          values("1.49780");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0094;
    }
    pin("i_uart_rx") {
      direction : input;
      capacitance : 0.0090;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.19959");
	}
	fall_constraint(scalar) {
          values("-0.09993");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.34772");
	}
	fall_constraint(scalar) {
          values("0.32453");
	}
      }
    }
    pin("o_uart_tx") {
      direction : output;
      capacitance : 0.0018;
      timing() {
        related_pin : "i_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00345,  0.01205,  0.02847,  0.05405,  0.08994,  0.13720,  0.19670,  0.26930,  0.35590");
          values("2.68492,2.70669,2.77903,2.91633,3.12999,3.42939,3.82283,4.31883,4.92439,5.64628");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00345,  0.01205,  0.02847,  0.05405,  0.08994,  0.13720,  0.19670,  0.26930,  0.35590");
          values("0.06717,0.09986,0.22031,0.45838,0.82978,1.34945,2.03445,2.89700,3.94855,5.20700");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00345,  0.01205,  0.02847,  0.05405,  0.08994,  0.13720,  0.19670,  0.26930,  0.35590");
          values("2.49886,2.51793,2.57144,2.65618,2.77941,2.95044,3.17557,3.45935,3.80535,4.21835");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00345,  0.01205,  0.02847,  0.05405,  0.08994,  0.13720,  0.19670,  0.26930,  0.35590");
          values("0.06391,0.08424,0.14696,0.26413,0.45871,0.74054,1.11430,1.58600,2.16070,2.84600");
	}
      }
    }
  }

}
