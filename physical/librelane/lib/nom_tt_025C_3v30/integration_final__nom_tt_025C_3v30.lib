library (integration_final) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 3.30;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
  }

  cell ("integration_final") {
    area : 917921.750 
    is_macro_cell : true;
    pin("i_clk") {
      direction : input;
      clock : true;
      capacitance : 0.1538;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("2.11354");
	}
	cell_fall(scalar) {
          values("2.18731");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("2.54003");
	}
	cell_fall(scalar) {
          values("2.60079");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0097;
    }
    pin("i_uart_rx") {
      direction : input;
      capacitance : 0.0096;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.41409");
	}
	fall_constraint(scalar) {
          values("-0.23845");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.68117");
	}
	fall_constraint(scalar) {
          values("0.62142");
	}
      }
    }
    pin("o_uart_tx") {
      direction : output;
      capacitance : 0.0019;
      timing() {
        related_pin : "i_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("4.57829,4.61477,4.73427,4.95886,5.30780,5.79665,6.43865,7.24765,8.23411,9.41265");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("0.11582,0.16939,0.36772,0.76069,1.37454,2.23500,3.36700,4.79400,6.53700,8.61200");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("4.25627,4.28823,4.37668,4.51336,4.70869,4.97787,5.33087,5.77587,6.31887,6.96687");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00348,  0.01217,  0.02876,  0.05462,  0.09089,  0.13860,  0.19880,  0.27220,  0.35970");
          values("0.10845,0.14196,0.24300,0.42892,0.73470,1.18000,1.77100,2.51900,3.43100,4.52000");
	}
      }
    }
  }

}
