        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("8.65518");
	}
	cell_fall(scalar) {
          values("7.17640");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("9.62630");
	}
	cell_fall(scalar) {
          values("8.09264");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0094;
    }
    pin("i_uart_rx") {
      direction : input;
      capacitance : 0.0106;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.02595");
	}
	fall_constraint(scalar) {
          values("1.38202");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.47051");
	}
	fall_constraint(scalar) {
          values("-0.60945");
	}
      }
    }
    pin("o_uart_tx") {
      direction : output;
      capacitance : 0.0025;
      timing() {
        related_pin : "i_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00344,  0.01199,  0.02831,  0.05375,  0.08944,  0.13640,  0.19560,  0.26780,  0.35390");
          values("17.28207,17.35543,17.57783,17.98276,18.61375,19.49704,20.65988,22.12487,23.91376,26.04560");
