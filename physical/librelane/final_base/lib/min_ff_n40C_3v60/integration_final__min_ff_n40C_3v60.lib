library (integration_final) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 3.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00345,  0.01205,  0.02848,  0.05408,  0.08999,  0.13720,  0.19680,  0.26950,  0.35610");
  }

  cell ("integration_final") {
    area : 787762.938 
    is_macro_cell : true;
    pin("i_clk") {
      direction : input;
      clock : true;
      capacitance : 0.1146;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.12355");
	}
	cell_fall(scalar) {
          values("1.17749");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.26884");
	}
	cell_fall(scalar) {
          values("1.32386");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0555;
    }
    pin("i_uart_rx") {
      direction : input;
      capacitance : 0.0122;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.47108");
	}
	fall_constraint(scalar) {
          values("-0.46379");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.63540");
	}
	fall_constraint(scalar) {
          values("0.68568");
	}
      }
    }
    pin("o_uart_tx") {
      direction : output;
      capacitance : 0.0090;
      timing() {
        related_pin : "i_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00345,  0.01205,  0.02848,  0.05408,  0.08999,  0.13720,  0.19680,  0.26950,  0.35610");
          values("3.13863,3.16378,3.24073,3.37803,3.59084,3.88884,4.28231,4.77784,5.38331,6.10490");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00345,  0.01205,  0.02848,  0.05408,  0.08999,  0.13720,  0.19680,  0.26950,  0.35610");
          values("0.08846,0.12149,0.23631,0.46354,0.83095,1.35094,2.03406,2.89906,3.94794,5.20835");
	}
	cell_fall(template_1) {
